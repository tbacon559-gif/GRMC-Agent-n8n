# A real Postgres connection string (e.g. a Neon branch). For a serverless
# deployment (Vercel), use the "pooled connection" string your provider
# gives you, not the direct one — see docs/decisions/0014.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# A SEPARATE Postgres database/branch used only by `npm test`. Required —
# vitest.global-setup.ts drops and recreates this database's schema on
# every test run, so it must never point at the same database as
# DATABASE_URL above. A free Neon "test" branch works well for this.
TEST_DATABASE_URL="postgresql://user:password@host/dbname_test?sslmode=require"

# Get a key at https://console.anthropic.com/ — required for conversation
# extraction and the AI assistant. The rest of the app works without it.
ANTHROPIC_API_KEY=""

# Shared secret the n8n Messenger workflow sends as the
# `x-n8n-webhook-secret` header when posting to /api/webhooks/n8n.
N8N_WEBHOOK_SECRET="dev-secret-change-me"

# HTTP Basic Auth password gate for the whole app (src/middleware.ts). There
# is no per-user login system, so set this before deploying to a public URL
# — leave unset for local dev, where the gate is a no-op.
SITE_PASSWORD=""
